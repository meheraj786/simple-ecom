// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
  UPCOMING
  COMING_SOON
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String?
  name         String
  provider     String   @default("local")
  googleId     String?  @unique
  avatar       String?
  role         String   @default("USER")
  isRegistered Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      Account?
  reviews      Review[]
  orders       Order[]  @relation("UserOrders")

  @@index([role])
  @@map("users")
}

model Account {
  id        String   @id @default(cuid())
  vendorId  String   @unique
  vendor    User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

model Category {
  id            String            @id @default(cuid())
  name          String            @unique
  slug          String            @unique
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  subCategories SubCategory[]
  products      ProductCategory[]

  @@map("categories")
}

model SubCategory {
  id         String               @id @default(cuid())
  name       String
  slug       String               @unique
  image      String?
  categoryId String
  category   Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   ProductSubCategory[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([categoryId])
  @@map("subcategories")
}

model Product {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  sku           String?              @unique
  baseImage     String?
  description   String?
  isActive      Boolean              @default(true)
  isNew         Boolean              @default(true)
  isBestSeller  Boolean              @default(false)
  isFeatured    Boolean              @default(false)
  status        ProductStatus        @default(IN_STOCK)
  averageRating Float                @default(0)
  categories    ProductCategory[]
  subCategories ProductSubCategory[]
  variants      ProductVariant[]
  reviews       Review[]
  orderItems    OrderItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  price          Decimal     @db.Decimal(12, 2)
  compareAtPrice Decimal?    @db.Decimal(12, 2)
  images         String[]
  options        Json
  isActive       Boolean     @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductSubCategory {
  id            String      @id @default(cuid())
  productId     String
  subCategoryId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, subCategoryId])
  @@index([subCategoryId])
  @@map("product_subcategories")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  rating    Int
  comment   String?
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation("UserOrders", fields: [userId], references: [id], onDelete: SetNull)
  customerId      String
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  city            String
  zipCode         String?
  totalAmount     Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  couponCode      String?
  status          String      @default("PENDING")
  paymentMethod   String      @default("COD")
  paymentStatus   String      @default("UNPAID")
  transactionId   String?     @unique
  paymentDetails  Json?
  divisionId      String
  items           OrderItem[]
  division        Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerPhone])
  @@index([customerEmail])
  @@index([transactionId])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  price           Decimal        @db.Decimal(12, 2)
  variantSnapshot Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Division {
  id             String   @id @default(cuid())
  name           String
  deliveryCharge Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@map("divisions")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}
